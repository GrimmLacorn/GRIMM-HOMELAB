{
  "name": "grimm-homelab-documentation",
  "private": true,
  "version": "0.1.0",
  "description": "Pinned documentation validation tools for GRIMM HOMELAB",
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "check:markdown": "python3 scripts/validate_markdown.py",
    "check:yaml": "node scripts/validate_yaml.mjs",
    "check:docs": "python3 scripts/validate_docs.py",
    "check:diagrams": "node scripts/validate_mermaid.mjs",
    "check:dependencies": "npm audit --audit-level=high",
    "check": "npm run check:markdown && npm run check:yaml && npm run check:docs && npm run check:diagrams && npm run check:dependencies",
    "security:secrets": "bash scripts/check-secrets.sh"
  },
  "devDependencies": {
    "dompurify": "3.4.17",
    "jsdom": "30.1.3",
    "mermaid": "12.2.0",
    "yaml": "2.9.1"
  }
}
